+func (ctrl *Controller) completeProviderAuthRequests(ctx context.Context, flow domain.Flow, event provider_auth.CredentialUpdatedEvent) (bool, error) {
+	actions, err := ctrl.service.GetFlowActions(ctx, flow.WorkspaceId, flow.Id)
+	if err != nil {
+		return false, fmt.Errorf("failed to get provider auth requests: %w", err)
+	}
+	completed := false
+	for _, action := range actions {
+		if action.ActionStatus != domain.ActionStatusPending || !action.IsHumanAction || !action.IsCallbackAction {
+			continue
+		}
+		requestKind, _ := action.ActionParams["requestKind"].(string)
+		if requestKind != string(flow_action.RequestKindProviderAuth) {
+			continue
+		}
+		provider, _ := action.ActionParams["provider"].(string)
+		profileId, _ := action.ActionParams["profileId"].(string)
+		if provider_auth.NormalizeProvider(provider) != provider_auth.NormalizeProvider(event.Provider) ||
+			!strings.EqualFold(common.NormalizeProfileId(profileId), common.NormalizeProfileId(event.ProfileId)) {
+			continue
+		}
+
+		response := flow_action.UserResponse{
+			TargetWorkflowId: flow.Id,
+			FlowActionId:     action.Id,
+			Choice:           string(event.Method),
+		}
+		if err := ctrl.completeFlowAction(ctx, &action, response); err != nil {
+			return completed, err
+		}
+		completed = true
+	}
+	return completed, nil
+}
