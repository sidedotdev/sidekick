+func newEnvSettingsTestEnv(t *testing.T) *testsuite.TestWorkflowEnvironment {
+	t.Helper()
+	var workflowSuite testsuite.WorkflowTestSuite
+	wfEnv := workflowSuite.NewTestWorkflowEnvironment()
